

.NewspartialTimelineW
  .zero-height.collapse-expand{ id: "#{newspartial.id.to_s}-wrapped-1" } <>
  .NewspartialTimeline{ style: "height: #{newspartial.duration_ms*HEIGHT_MS}px; min-height: 100px;" }

    .main
      - newspartial.config['wtimes']&.each_with_index do |wtime, idx|

        %div.timestamp{ style: "top: #{wtime.to_f*HEIGHT_MS}px"}
          .wtime= wtime
          .word= newspartial.config['words'][idx]

    - newspartial.newsvideo_events.each do |ev|
      = render 'wco/newsvideo_events/show_in_newsvideo', event: ev

    .full-text
      .header.collapse-expand{ id: newspartial.id.to_s }
        newspartial::#{newspartial.slug}
        = link_to '[~]', edit_newspartial_path(newspartial)
        = link_to '[+newsvideo_event]', new_newsvideo_event_path(newspartial_id: newspartial.id)
        %span{ class: 'gray' } #{newspartial.id}
        = link_to '[config.json]', api_newspartial_config_path(newspartial, format: :json, api_key: Wco::Setting.get('WASYACO_SIMPLE_API_KEY'), api_secret:  Wco::Setting.get('WASYACO_SIMPLE_API_SECRET') ), target: :_blank

      .full-textC
        .flex-row
          .d-inline-block= button_to 'x', newspartial_path(newspartial), method: :delete, :data => { :confirm => 'Are you sure?' }
          .a Duration: `#{newspartial.duration_ms}`ms
          .descr= newspartial.body
          .d-flex.flex-column

            -# = link_to 'Generate video 1', api_newsproducer_studio_1_path({ newspartial_id: newspartial.id.to_s, wco_origin: request.base_url, api_key: Wco::Setting.get('WASYACO_SIMPLE_API_KEY'), api_secret: Wco::Setting.get('WASYACO_SIMPLE_API_SECRET') }), target: :_blank, class: 'btn btn-primary', data: { confirm: 'Are you sure?' }
            -# = link_to 'Generate video green', api_newsproducer_studio_green_path({ newspartial_id: newspartial.id.to_s, wco_origin: request.base_url, api_key: Wco::Setting.get('WASYACO_SIMPLE_API_KEY'), api_secret: Wco::Setting.get('WASYACO_SIMPLE_API_SECRET') }), target: :_blank, class: 'btn btn-primary', data: { confirm: 'Are you sure?' }
            = link_to '_blue 2', api_newsproducer_studio_blue_path({ newspartial_id: newspartial.id.to_s, wco_origin: request.base_url, api_key: Wco::Setting.get('WASYACO_SIMPLE_API_KEY'), api_secret: Wco::Setting.get('WASYACO_SIMPLE_API_SECRET') }), target: :_blank, class: 'btn btn-primary' # , data: { confirm: 'Are you sure?' }

            Video:
            - if newspartial.video
              = image_tag newspartial.video.thumb.url(:thumb), class: 'thumb'
              = link_to 'view', video_path(newspartial.video)
          .d-flex.flex-column
            = form_tag newspartial_generate_speech_path(newspartial), data: { confirm: 'Are you sure?' } do
              = select_tag :voice, options_for_select([ nil, 'am_fenrir', 'am_michael', 'am_puck', 'af_bella', 'af_heart', 'af_jessica', 'af_nicole', 'bf_emma' ], selected: newspartial.voice)
              = submit_tag 'Generate speech'
            .small.gray Requires HeadTTS.git on :8882
            Audio:
            - if newspartial.audio.present?
              %audio{ controls: true }
                %source{ src: newspartial.audio, type: "audio/wav" }
                Your browser does not support the audio element.
