
%table.bordered.tags--index.maxwidth
  %thead.sticky
    %tr
      %th &nbsp;
      %th N Conv
      %th N Stubs

      %th N Headlines

      %th N Galleries
      %th N Reports
      %th N Videos

      %th N Leadsets
      %th N Leads

      %th N Logs
  %tbody
    - tags.each do |tag|
      %tr
        %td
          = link_to '[~]', edit_tag_path(tag)
          = link_to tag.slug, tag_path(tag)
        %td= tag.conversations.length
        %td= tag.message_stubs.length
        %td= tag.headlines.length
        %td= tag.galleries.length
        %td= tag.reports.length
        %td= tag.videos.length
        %td= tag.leadsets.length
        %td= tag.leads.length
        %td= tag.logs.length