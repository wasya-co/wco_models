<html>
  <head>
    <title>Studio Any</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" >

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

    <%= stylesheet_link_tag    "wco/application", media: "all" %>
    <%= stylesheet_link_tag    "wco/studio", media: "all" %>
  </head>
  <body>

<script async src="https://unpkg.com/es-module-shims@1.3.6/dist/es-module-shims.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="/vendor/javascript/CCapture.all.min.js"></script>

<script type="importmap">
{ "imports":
  {
    "three": "https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js/+esm",
    "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/",
    "talkinghead": "https://cdn.jsdelivr.net/gh/wasya-co/TalkingHead@1.7.1/modules/talkinghead.mjs"
  }
}
</script>

<div class='position-absolute'>
  <%= render 'wco/newspartials/timeline', newspartial: @newspartial %>
</div>

<div class='StudioW1'>
  <div class='StudioW0'>

    <div class='studio d-flex ctrl-row'>
      <div class='item'>
        <select class='studio'></select>
        <em>Status:</em><span id='status'>pending</span>
      </div>
    </div>

    <div class='active_spot d-flex ctrl-row'>
      <div class='item'>
        <label>
          <input type="radio" name="active_spot" value="spot_1">
          spot 1
        </label>
      </div>
      <div class='item'>
        <label>
          <input type="radio" name="active_spot" value="spot_2" >
          spot 2
        </label>
      </div>
      <div class='item'>
          <label>
          <input type="radio" name="active_spot" value="spot_3" >
          spot 3
        </label>
      </div>
      <div class='item'>
        <button id='speak'>Speak</button>
      </div>
      <div class='item'>
        <select class='gestures' ><option></option></select>
        <button id='jesture'>Jesture</button>
      </div>
    </div>

    <div id='avatar_1'></div><div id='avatar_2'></div><div id='avatar_3'></div>
    <div id='loading'>&nbsp;</div>
    <div id="rotatingC" class="r2" style="width: 854px;
      height: 480px;
      border: 1px solid red;
      text-align: center; " >
    </div>

    <div class='avatars d-flex ctrl-row'>
      <div class='item'>
        spot 1
        <select class='avatars' data-spot_id="spot_1" ><option></option></select>
      </div>
      <div class='item'>
        spot 2
        <select class='avatars' data-spot_id='spot_2' ><option></option></select>
      </div>
      <div class='item'>
        spot 3
        <select class='avatars' data-spot_id='spot_3' ><option></option></select>
      </div>
    </div>

    <div class='active_camera d-flex ctrl-row'>
      <label>
        <input type="radio" name="active_camera" value="wide" checked>
        cam wide
      </label>
      <label>
        <input type="radio" name="active_camera" value="spot_1">
        spot 1
      </label>
      <label>
        <input type="radio" name="active_camera" value="spot_2">
        spot 2
      </label>
      <label>
        <input type="radio" name="active_camera" value="spot_3">
        spot 3
      </label>

    </div>

    <div class='lights d-flex ctrl-row'>
      <label>
        <input type="checkbox" class='light-ctrl' name="ambientLight" value="on" checked>
        ambientLight
      </label>
      <label>
        <input type="checkbox" class='light-ctrl' name="hemiLight" value="on" checked>
        hemiLight
      </label>
      <label>
        <input type="checkbox" class='light-ctrl' name="keyLight" value="on" checked>
        keyLight
      </label>
      <label class='border-yellow'>
        <input type="checkbox" id='is_shadows' name="shadows" value="on" checked>
        cast shadows
      </label>
      <label>
        <input type="checkbox" class='light-ctrl' name="fillLight" value="on" checked>
        fillLight
      </label>
      <label>
        <input type="checkbox" class='light-ctrl' name="rimLight" value="on" checked>
        rimLight
      </label>
    </div>


  </div>
</div>

<script type="module"><%= render 'studio_blue2.js' %></script>

</body></html>
