
.newsvideos--form
  = form_for newsvideo do |f|
    .actions
      = f.submit

    .field.flex-row
      %label Title
      = f.text_field :title, class: 'w-100'
    .field.flex-row
      %label Slug
      = f.text_field :slug, class: 'w-100'

    .row
      .a
        .field
          %label w_px
          = f.text_field :w_px
      .a
        .field
          %label h_px
          = f.text_field :h_px
      .descr
        %ul
          %li 1280x720 16:9
          %li 1024x768 4:3
          %li 854x480 16:9
          %li 640x360 16:9
          %li 640x480 4:3

    .field
      %label Body
      = f.text_area :body, class: 'tinymce'

    .field
      %label Tags (#{newsvideo.tags.length}):
      -# = render '/wco/tags/index', tags: newsvideo.tags
      = f.select :tag_ids, options_for_select(@tags_list, selected: newsvideo.tag_ids), {}, { multiple: true, class: 'select2' }

    .field
      %label next_overlay_ms
      = f.text_field :next_overlay_ms

    .actions
      = f.submit
