<html>
  <head>
    <title>Studio FPS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <style>

    html, body { touch-action: manipulation }

    </style>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" >

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

    <%= stylesheet_link_tag    "wco/application", media: "all" %>
    <%= stylesheet_link_tag    "wco/studio", media: "all" %>

  </head>
  <body>

  <style><%= render 'touch_pad.css' %></style>

  <script><%= render 'scenes.js' %></script>


<script async src="https://unpkg.com/es-module-shims@1.3.6/dist/es-module-shims.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="/vendor/javascript/CCapture.all.min.js"></script>

<script type="importmap">
{ "imports":
  {
    "three":         "https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js/+esm",
    "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/",
    "talkinghead":   "https://cdn.jsdelivr.net/gh/wasya-co/TalkingHead@1.7.1/modules/talkinghead.mjs"
  }
}
</script>

<div class='StudioW1'>
  <div class='StudioW0'>

    <div class='ctrl-row header-row'>
      <b>Studio FPS</b>
      <div class='item'>
        <select class='studio'></select>
        <em>Status:</em><span id='status'>pending</span>
      </div>
      <button id='fullScreen' />fullScrn</button>

      <div class='item'>
        <label>
          <input type="radio" name="ctrl-type" value="touch"> Touch
        </label>
        <label>
          <input type="radio" name="ctrl-type" value="fps"> FPS
        </label>
      </div>

      <div class='item'>
        <label>
          <input type="checkbox" class='weapon-ctrl' name="weaponCtrl" value="on" checked>
          Use Weapons
        </label>
      </div>

    </div>



    <div class='rotatingW'>
      <div id="rotatingC" class="r2" style="position: relative;
        border: 1px solid red;
        text-align: center; " >
        <div style="position:absolute;left:50%;top:50%;width:14px;height:14px;margin:-7px 0 0 -7px;pointer-events:none;z-index:2;">
          <div style="position:absolute;left:50%;top:0;width:2px;height:100%;margin-left:-1px;background:#fff;"></div>
          <div style="position:absolute;top:50%;left:0;height:2px;width:100%;margin-top:-1px;background:#fff;"></div>
        </div>
      </div>
    </div>

    <div class='ctrl-row'>
    <div class='item'>
      <label>
        <input type="radio" name="head" value="1" checked>
        head 1
      </label>
    </div>
    <div class='item'>
      <label>
        <input type="radio" name="head" value="2">
        head 2
      </label>
    </div>
    <div class='item'>
        <label>
        <input type="radio" name="head" value="3">
        head 3
      </label>
    </div>
    <div class='item'>
      <button id='speak'>Speak</button>
    </div>
    <div class='item'>
      <select class='gestures' ><option></option></select>
      <button id='jesture'>Jesture</button>
    </div>
  </div>

  <div id='avatar_1'></div><div id='avatar_2'></div><div id='avatar_3'></div>
  <div id='loading'>&nbsp;</div>

    <div class='d-flex heads ctrl-row'>
      <div class='item'>
        head 1
        <select class='avatar' data-uid="1" ><option></option></select>
      </div>
      <div class='item'>
        head 2
        <select class='avatar' data-uid='2' ><option></option></select>
      </div>
      <div class='item'>
        head 3
        <select class='avatar' data-uid='3' ><option></option></select>
      </div>
    </div>

    <div class='d-flex cameras ctrl-row'>
      <label>
        <input type="radio" name="camera" value="wide" checked>
        cam wide
      </label>
      <label>
        <input type="radio" name="camera" value="av_1">
        cam 1
      </label>
      <label>
        <input type="radio" name="camera" value="av_2">
        cam 2
      </label>
      <label>
        <input type="radio" name="camera" value="av_3">
        cam 3
      </label>

    </div>

    <div class='ctrl-row lights'>
      <label>
        <input type="checkbox" class='light-ctrl' name="ambientLight" value="on" checked>
        ambientLight
      </label>
      <label>
        <input type="checkbox" class='light-ctrl' name="hemiLight" value="on" checked>
        hemiLight
      </label>
      <label>
        <input type="checkbox" class='light-ctrl' name="keyLight" value="on" checked>
        keyLight
      </label>
      <label class='border-yellow'>
        <input type="checkbox" id='is_shadows' name="shadows" value="on" checked>
        cast shadows
      </label>
      <label>
        <input type="checkbox" class='light-ctrl' name="fillLight" value="on" checked>
        fillLight
      </label>
      <label>
        <input type="checkbox" class='light-ctrl' name="rimLight" value="on" checked>
        rimLight
      </label>
    </div>


  </div>
</div>

<script type="module"><%= render 'touch_controls.js' %></script>
<script type="module"><%= render 'studio_fps.js' %></script>

</body></html>
