<html>
  <head>
    <title>Studio Blue</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" >

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

    <%= stylesheet_link_tag    "wco/application", media: "all" %>
    <%= stylesheet_link_tag    "wco/studio", media: "all" %>
  </head>
  <body>

<script async src="https://unpkg.com/es-module-shims@1.3.6/dist/es-module-shims.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="/vendor/javascript/CCapture.all.min.js"></script>

<script type="importmap">
{ "imports":
  {
    "three": "https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js/+esm",
    "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/",
    "talkinghead": "https://cdn.jsdelivr.net/gh/met4citizen/TalkingHead@1.7/modules/talkinghead.mjs"
  }
}
</script>

<div class='position-absolute'>
  <%= render 'wco/newspartials/timeline', newspartial: @newspartial %>
</div>

<div class='StudioW1'>
  <div class='StudioW0'>

    <div class='header-row'>
      <b>Studio Blue</b>
      <em>Status:</em><span id='status'>pending</span>
      <button id='speak'>Speak</button>

      <div class='item'>
        <select class='jesture' ></select>
        <button id='jesture'>Jesture</button>
      </div>
    </div>

    <div id='avatar_1'></div>
    <div id='avatar_2'></div>
    <div id='avatar_3'></div>
    <div id='loading'>&nbsp;</div>
    <div id="rotatingC" class="r2" style="width: 854px;
      height: 480px;
      border: 1px solid red;
      text-align: center; " >
    </div>

    <div class='d-flex heads ctrl-row'>
      <div class='item'>
        <label>
          <input type="radio" name="head" value="1" checked>
          head 1
        </label>
        <select class='avatar' data-uid="1" ></select>
      </div>
      <div class='item'>
        <label>
          <input type="radio" name="head" value="2">
          head 2
        </label>
        <select class='avatar' data-uid='2' ></select>
      </div>
    </div>

    <div class='d-flex cameras ctrl-row'>
      <label>
        <input type="radio" name="camera" value="1" checked>
        camera_1
      </label>
      <label>
        <input type="radio" name="camera" value="2">
        camera_2
      </label>
      <label>
        <input type="radio" name="camera" value="3">
        camera_3
      </label>
    </div>

    <div class='d-flex lights ctrl-row'>
      <label>
        <input type="checkbox" class='light-ctrl' name="ambientLight" value="on" checked>
        ambientLight
      </label>
      <label>
        <input type="checkbox" class='light-ctrl' name="hemiLight" value="on" checked>
        hemiLight
      </label>
      <label>
        <input type="checkbox" class='light-ctrl' name="keyLight" value="on" checked>
        keyLight
      </label>
      <label>
        <input type="checkbox" class='light-ctrl' name="fillLight" value="on" checked>
        fillLight
      </label>
      <label>
        <input type="checkbox" class='light-ctrl' name="rimLight" value="on" checked>
        rimLight
      </label>
    </div>


  </div>
</div>

<script type="module"><%= render 'studio_blue2.js' %></script>

</body></html>
